# Copy to .env.local and fill in what you have. Everything is optional: the app
# runs fully offline with embedded Postgres (PGlite) and a statistical pricing model.

# Sessions + custodial wallet encryption. Any long random string. Required in production.
APP_SECRET=

# Gemma, run locally with Ollama (https://ollama.com): odds, resolution rules, summaries,
# stock re-marks. Leave OLLAMA_MODEL empty and the app prices from history with a stats model.
# OLLAMA_MODEL=gemma4:12b
# OLLAMA_EMBEDDING_MODEL=embeddinggemma-2:270m
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_API_KEY=            # bearer token, for a shared Ollama behind an authenticating proxy

# No Ollama? Use Gemma hosted by Google instead: make a free key at https://aistudio.google.com/apikey
# and paste it here (never commit it). With only the key set, the app uses Google's Gemma. With
# OLLAMA_MODEL set too, Ollama goes first and Google takes over whenever Ollama isn't running.
# Free-tier limits are per Google project, so each teammate should use a key from their own project.
# GEMMA_API_KEY=
# GEMMA_API_MODEL=gemma-4-26b-a4b-it        # or gemma-4-31b-it (slower, a bit sharper)
# GEMMA_API_EMBEDDING_MODEL=gemini-embedding-001   # "none" to keep stake titles off Google's embedder
# AI_PROVIDER=google                        # force one: ollama | google | none

# Postgres. Leave empty for embedded PGlite (./.data). Point at Tiger Cloud (Timescale)
# to get hypertables, hourly-candle continuous aggregates and compression automatically.
# DATABASE_URL=postgres://tsdbadmin:PASSWORD@HOST.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
# Local Timescale: docker compose up -d  then
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/friendstakes

# Solana: run `npm run solana:setup` to generate these into .env.local. SOLANA_CLUSTER picks the
# chain: localnet (a local validator, the default) or devnet. SOLANA_RPC_URL overrides its RPC.
SOLANA_CLUSTER=localnet
# SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_PAYER_SECRET=
SOLANA_MINT=
# Each chain operation first creates a one-off receipt account, so the chain itself refuses to apply
# the same operation twice. Costs about 0.0009 SOL of rent per operation: free on a local validator,
# about 1,100 operations per devnet SOL. Set to false to go without (the outbox still saves and checks
# every signature before resending).
SOLANA_OP_RECEIPTS=true
# Public copy: `npm run solana:devnet` republishes confirmed transactions to devnet and saves
# these two itself (the payer needs devnet SOL from https://faucet.solana.com).
SOLANA_DEVNET_PAYER_SECRET=
SOLANA_DEVNET_MINT=


# Coin name is a placeholder until the team picks one.
# NEXT_PUBLIC_CURRENCY_NAME=Clout
# NEXT_PUBLIC_CURRENCY_TICKER=CLT

# Time machine buttons (+1h/+1d/+1w) for demos. Only ADMIN_USERNAMES accounts see them, and
# only their own clock moves. Set to false for real use.
DEMO_MODE=true

# Usernames allowed to see the Solana chain pages, pricing records and demo clock (comma or space
# separated). Leave it as stakesadmin unless you mean to make someone else an admin.
ADMIN_USERNAMES=stakesadmin
# The admin's password. npm run setup makes the admin account with it (and writes a random one
# here if it's empty on a local copy). Never commit it.
ADMIN_PASSWORD=
# Demo: every account, old and new, gets the synthetic sample chats. false for real use.
DEMO_DATA_FOR_ALL=true
# Sample people post the odd reply and trade in the sample chats. false turns them off.
# DEMO_BOTS=true
# Background jobs (allowances, stock decay, settling, the chain outbox). off for a second copy
# that shares a database with the live one, so the jobs only run once.
# FS_WORKER=on
