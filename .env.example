# Copy to .env.local and fill in what you have. Everything is optional: the app
# runs fully offline with embedded Postgres (PGlite) and a statistical pricing model.

# Sessions + custodial wallet encryption. Any long random string. Required in production.
APP_SECRET=

# Google Gemini (https://aistudio.google.com/apikey): odds, resolution rules, summaries, stock re-marks.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Postgres. Leave empty for embedded PGlite (./.data). Point at Tiger Cloud (Timescale)
# to get hypertables, hourly-candle continuous aggregates and compression automatically.
# DATABASE_URL=postgres://tsdbadmin:PASSWORD@HOST.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
# Local Timescale: docker compose up -d  then
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/friendstakes

# Solana devnet: run `npm run solana:setup` to generate these into .env.local.
SOLANA_PAYER_SECRET=
SOLANA_MINT=
# SOLANA_RPC_URL=https://api.devnet.solana.com

# ElevenLabs voice recaps (falls back to the browser's speech without it).
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Coin name is a placeholder until the team picks one.
# NEXT_PUBLIC_CURRENCY_NAME=Clout
# NEXT_PUBLIC_CURRENCY_TICKER=CLT

# Time machine buttons (+1h/+1d/+1w) for demos. Set to false for real use.
DEMO_MODE=true
