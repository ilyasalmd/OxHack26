# Copied to deploy/.env by setup.sh, which fills in the first three. Edit, then:
#   docker compose up -d   (from deploy/)

# Public hostname Caddy gets a certificate for. With no domain, use <server-ip>.sslip.io.
DOMAIN=
# Long random strings. Never change APP_SECRET once people have signed up: it signs
# sessions and encrypts the custodial Solana wallets.
APP_SECRET=
POSTGRES_PASSWORD=

# Time machine for the admin only. Leave on for a demo.
DEMO_MODE=true
# Every account gets the synthetic sample chats. false for real use.
DEMO_DATA_FOR_ALL=true
# The admin (Chain page, pricing records, demo clock) and its password. npm run setup makes the
# account; update.sh runs it after each deploy, so new sample data arrives by itself.
ADMIN_USERNAMES=stakesadmin
ADMIN_PASSWORD=
# The branch the server follows (update.sh, every 5 minutes).
DEPLOY_BRANCH=main

# Optional: copy these from your local .env.local. A server has no local validator, so use devnet.
SOLANA_CLUSTER=devnet
SOLANA_PAYER_SECRET=
SOLANA_MINT=
# On-chain receipt per operation (stops double payments even if the RPC loses track). About 0.0009 SOL each.
SOLANA_OP_RECEIPTS=true
