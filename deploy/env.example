# Copied to deploy/.env by setup.sh, which fills in the first three. Edit, then:
#   docker compose up -d   (from deploy/)

# Public hostname Caddy gets a certificate for. With no domain, use <server-ip>.sslip.io.
DOMAIN=
# Long random strings. Never change APP_SECRET once people have signed up: it signs
# sessions and encrypts the custodial Solana wallets.
APP_SECRET=
POSTGRES_PASSWORD=

# Time machine buttons move the clock for everyone on the server. Leave on for a demo.
DEMO_MODE=true

# Optional: copy these from your local .env.local.
SOLANA_PAYER_SECRET=
SOLANA_MINT=
ELEVENLABS_API_KEY=
