{
  "name": "friendstakes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "ai:eval": "tsx --env-file-if-exists=.env.local scripts/ai-eval.ts",
    "demo:join": "tsx --env-file-if-exists=.env.local scripts/demo-join.ts",
    "seed:fast": "rm -rf .data/seed-pglite && DATABASE_URL=pglite PGLITE_DIR=.data/seed-pglite tsx --env-file-if-exists=.env.local scripts/seed.ts && tsx --env-file-if-exists=.env.local scripts/push-seed.ts",
    "solana:setup": "tsx --env-file-if-exists=.env.local scripts/solana-setup.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@google/genai": "^2.31.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bcryptjs": "^3.0.3",
    "bs58": "^6.0.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
